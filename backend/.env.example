# --- Database ---
DATABASE_URL=sqlite:///../data/jobs.db

# --- Vector DB ---
CHROMA_PATH=../data/chroma

# --- Timezone ---
TIMEZONE=America/Edmonton

# --- Search defaults (can be overridden in Settings UI, stored in DB) ---
SEARCH_LOCATION=Calgary, Alberta, Canada
SEARCH_COUNTRY=Canada
SEARCH_RESULTS_PER_SITE=50
SEARCH_DISTANCE=50

# --- Schedule (24h local time, HH:MM) ---
SEARCH_TIME_MORNING=08:00
SEARCH_TIME_AFTERNOON=12:00
SEARCH_TIME_EVENING=20:00

# --- Optional AI API (NOT required for core functionality) ---
# Only used if you wire up an "auto-generate matching explanation via LLM" feature later.
# The resume improvement feature just generates a prompt for you to paste elsewhere manually.
ANTHROPIC_API_KEY=

# --- Resume storage ---
RESUME_STORAGE_DIR=../data/resume

# --- CORS (frontend dev server) ---
FRONTEND_ORIGIN=http://localhost:5173
