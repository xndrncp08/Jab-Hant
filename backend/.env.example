# Copy to backend/.env. Every value is optional; defaults live in app/config.py.

# DATABASE_URL=sqlite:///../data/jobs.db
# CHROMA_PATH=../data/chroma
# RESUME_STORAGE_DIR=../data/resume

TIMEZONE=America/Edmonton
SEARCH_LOCATION=Calgary, Alberta, Canada
SEARCH_COUNTRY=Canada
SEARCH_RESULTS_PER_SITE=20
SEARCH_DISTANCE=50

SEARCH_TIME_MORNING=08:00
SEARCH_TIME_AFTERNOON=12:00
SEARCH_TIME_EVENING=20:00

# Optional. Resume tailoring uses Claude via this key if set, else via the
# local Claude Code login (`claude` on PATH; a Claude Pro plan works), else
# free offline keyword tailoring. Either Claude route sends your resume text
# and the job description to Anthropic.
ANTHROPIC_API_KEY=

FRONTEND_ORIGIN=http://localhost:5173

# Set both to require a login (strongly recommended for any deployment).
APP_USERNAME=
APP_PASSWORD=
